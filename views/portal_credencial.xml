<odoo>
    <template id="portal_mi_credemcoal"    name="Mi Credenciañ"
              inherit_id="portal.portal_my_home"        priority="30">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <div class="o_portal_category row g-2 mt-3" id="portal_common_credencial">
                <t t-call="portal.portal_docs_entry" t-if="False"/>
                <t t-call="portal.portal_docs_entry">
                    
                    <t t-set="icon" t-value="'/instance_sindicato/static/src/img/card.png'"/>
                    <t t-set="title">Mi Credencial</t>
                    <t t-set="text">Aqui podras ver o descargar tu credencial SNTSS XXV</t>                    
                    <t t-set="url" t-value="'/my/credencial/%s' % request.env.user.partner_id.id"/>
                    <t t-set="config_card" t-value="True"/>
                </t>
            </div>
        </xpath>
    </template>


    <template id="portal_credencial" name="Mi credencial">
        <t t-call="portal.portal_layout">    
            <t t-set="additional_title">Security</t>
            <t t-set="no_breadcrumbs" t-value="1"/>

            <t t-if="partner.matricula">
                <t t-set="page_title">Mi Credencial</t>
            </t>
            <t t-else="">
                <t t-set="page_title">Mi Familia / Credencial</t>
            </t>


            <t t-if="partner.matricula">
                <t t-set="back_url">/my/</t>
            </t>
            <t t-else="">
                <t t-set="back_url">/my/children</t>
            </t>


            
            
            <t t-call="instance_sindicato.portal_page_header"/>

            <div class="container">
               
                <div class="card mx-auto" style="width:500px; height:439px; background-image:url('/instance_sindicato/static/description/company/fondo.png'); text-shadow: -1px #fff,">
                    
                    <div style="position:absolute; left:0px; top:140px; width:250px;" class="text-center">
                        <div style="" class="text-center">
                            <img t-att-src="'/my/image/%s' % partner.id"
                                class="rounded-circle mb-3"
                                style="width:120px;height:120px;object-fit:cover;"/>

                            <div style="position:absolute; left:0px; top:150px; width:100%" class="text-center">
                                <h6 style="color:#aaa;">
                                    <t t-esc="partner.name"/>
                                </h6>
                            </div> 
                            <div style="position:absolute; left:0px; top:180px; width:100%" class="text-center">
                                <h7 style="color:#aaa;">
                                    
                                    <t t-if="partner.matricula">
                                        <t t-esc="partner.function"/>
                                    </t>
                                    <t t-else="">HIJO</t>
                                </h7>
                            </div>                          

                            <div style="position:absolute; left:0px; top:200px; width:100%" class="text-center">
                                <h7 style="color:#aaa;">
                                    <t t-esc="partner.matricula"/>
                                </h7>
                            </div>                          
                        </div>
                    </div>
                    <div style="position:absolute; right:0px; width:250px; top:70px;" class="text-center">
                        <img t-att-src="'data:image/png;base64,%s' % qr_code"  style="width:150px;"/>
                            <div style="position:absolute; left:0px; top:190px; width:100%" class="text-center">
                                <h6 style="color:#aaa;">
                                    <span t-esc="company.street"/>
                                </h6>
                            </div> 
                            <div style="position:absolute; left:0px; top:205px; width:100%" class="text-center">
                                <h8 style="color:#aaa;">
                                    Secretario General 
                                    <span t-esc="company.name"/>
                                </h8>
                            </div> 


                            <div style="position:absolute; left:0px; top:250px; width:100%" class="text-center">
                                <h6 style="color:#aaa;">
                                    
                                    <t t-if="partner.matricula">
                                        <span t-esc="company.street2"/>
                                    </t>
                                    <t t-else="">En caso de accidente llamar a</t>

                                </h6>
                            </div> 
                            <div style="position:absolute; left:0px; top:270px; width:100%" class="text-center">
                                <h6 style="color:#aaa;">

                                    <t t-if="partner.matricula">
                                        CP <span t-esc="company.zip"/>, <span t-esc="company.city"/>
                                    </t>
                                    <t t-else="">
                                        <t t-esc="partner.parent_contact_id.name"/>
                                    </t>


                                    
                                </h6>
                            </div> 
                            <div style="position:absolute; left:0px; top:290px; width:100%" class="text-center">
                                <h6 style="color:#aaa;">
                                    

                                    <t t-if="partner.matricula">
                                        <span t-esc="company.phone"/>
                                    </t>
                                    <t t-else="">
                                        <t t-esc="partner.parent_contact_id.phone"/>
                                    </t>


                                </h6>
                            </div> 
                    </div>
                

                    <t t-if="partner.estatus != 'Valido'">
                        <div style="position:absolute; left:0; top:0; width:100%; height:100%; z-index:9999; display:flex; align-items:center; justify-content:center; background:rgba(255,255,255,0.45); "> 
                            <div style="transform:rotate(-20deg); font-weight:bold; color:#d00000; border:5px solid #d00000; padding:15px 35px; text-align:center; white-space:nowrap; "> 
                                <div style="font-size:42px;"> 
                                    CREDENCIAL NO VÁLIDA 
                                </div> 
                                <div style="font-size:20px; ">             
                                    VALIDA TUS DOCUMENTOS O FOTO 
                                </div> 
                            </div> 
                        </div> 
                    </t>                
                </div>
            </div>
        </t>

    </template>
</odoo>


