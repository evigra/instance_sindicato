<odoo>
<template id="portal_credencial" name="Mi credencial">
    <t t-call="portal.portal_layout">    
        <div class="container">
            <div class="card mx-auto" style="width:500px; height:439px; background-image:url('/instance_sindicato/static/description/company/fondo.png'); text-shadow: -1px #fff,">
                <!--
                <div style="position:absolute; left:10px; margin:15px;" >
                    <img src="/instance_sindicato/static/description/company/logo.png" alt="Logo" style="width: 60px;"/>
                </div>
                <div style="position:absolute; right:25px;  margin:15px;">
                    <img src="/instance_sindicato/static/description/company/logoIMSS.png" alt="Logo" style="width: 50px;"/>
                </div>
                -->
                <div style="position:absolute; left:0px; top:140px; width:250px;" class="text-center">
                    <div style="" class="text-center">
                        <img t-att-src="'/web/image/res.partner/%s/image_1920' % partner.id"
                            class="rounded-circle mb-3"
                            style="width:120px;height:120px;object-fit:cover;"/>

                        <div style="position:absolute; left:0px; top:150px; width:100%" class="text-center">
                            <h6 style="color:#aaa;">
                                <t t-esc="partner.name"/>
                            </h6>
                        </div> 
                        <div style="position:absolute; left:0px; top:180px; width:100%" class="text-center">
                            <h6 style="color:#aaa;">
                                <t t-esc="partner.email"/>
                            </h6>
                        </div>                          
                    </div>
                </div>
                <div style="position:absolute; right:0px; width:250px; top:70px;" class="text-center">
                    <img t-att-src="'data:image/png;base64,%s' % qr_code"  style="width:150px;"/>
                        <div style="position:absolute; left:0px; top:190px; width:100%" class="text-center">
                            <h6 style="color:#aaa;">
                                <span t-esc="company.street"/>
                            </h6>
                        </div> 
                        <div style="position:absolute; left:0px; top:205px; width:100%" class="text-center">
                            <h8 style="color:#aaa;">
                                Secretario General 
                                <span t-esc="company.name"/>
                            </h8>
                        </div> 


                        <div style="position:absolute; left:0px; top:250px; width:100%" class="text-center">
                            <h6 style="color:#aaa;">
                                <span t-esc="company.street2"/>
                            </h6>
                        </div> 
                        <div style="position:absolute; left:0px; top:270px; width:100%" class="text-center">
                            <h6 style="color:#aaa;">
                                CP <span t-esc="company.zip"/>, <span t-esc="company.city"/>
                            </h6>
                        </div> 
                        <div style="position:absolute; left:0px; top:290px; width:100%" class="text-center">
                            <h6 style="color:#aaa;">
                                <span t-esc="company.phone"/>
                            </h6>
                        </div> 

                </div>
            </div>
        </div>
    </t>

</template>
</odoo>


