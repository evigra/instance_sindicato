<odoo>
    <!--##############################################-->
    <!--############### TEMPLATE MAIL ################-->
    <!--##############################################-->


    <template id="template_mail">
            <table border="0"
                cellpadding="0"
                cellspacing="0"
                style="padding-top: 16px;
                        background-color: #FFFFFF;
                        font-family:Verdana, Arial,sans-serif;
                        color: #454748;
                        width: 100%;
                        border-collapse:separate;">

                <tr>
                    <td align="center">

                        <table border="0"
                            cellpadding="0"
                            cellspacing="0"
                            width="590"
                            style="padding: 16px;
                                    background-color: #FFFFFF;
                                    color: #454748;
                                    border-collapse:separate;">

                            <tbody>

                                <!-- HEADER -->
                                <tr>
                                    <td align="center"
                                        style="min-width: 590px;">

                                        <table border="0"
                                            cellpadding="0"
                                            cellspacing="0"
                                            width="590"
                                            style="min-width: 590px;
                                                    background-color: white;
                                                    padding: 0px 8px 0px 8px;
                                                    border-collapse:separate;">

                                            <tr>

                                                <td valign="middle">

                                                    <span style="font-size: 10px;">
                                                        Apreciable
                                                    </span>
                                                    <br/>

                                                    <span style="font-size: 20px;
                                                                font-weight: bold;">

                                                        <t t-out="object.name or ''">
                                                            Marc Demo
                                                        </t>

                                                    </span>

                                                </td>

                                                <td valign="middle"
                                                    align="right"
                                                    t-if="not object.env.company.uses_default_logo">

                                                    <img t-attf-src="/logo.png?company={{ object.env.company.id }}"
                                                        style="padding: 0px;
                                                                margin: 0px;
                                                                height: auto;
                                                                width: 80px;"
                                                        t-att-alt="object.env.company.name"/>

                                                </td>

                                            </tr>

                                            <tr>
                                                <td colspan="2"
                                                    style="text-align:center;">

                                                    <hr width="100%"
                                                        style="background-color:rgb(204,204,204);
                                                            border:medium none;
                                                            clear:both;
                                                            display:block;
                                                            font-size:0px;
                                                            min-height:1px;
                                                            line-height:0;
                                                            margin:16px 0px 16px 0px;"/>

                                                </td>
                                            </tr>

                                        </table>

                                    </td>
                                </tr>

                                <!-- CONTENT -->
                                <tr>
                                    <td id="contenido"
                                        align="center"
                                        style="min-width: 590px;">
                                        <t t-out="0"/>
                                    </td>
                                </tr>

                                <!-- FOOTER -->
                                <tr>
                                    <td align="center"
                                        style="min-width: 590px;">

                                        <table border="0"
                                            cellpadding="0"
                                            cellspacing="0"
                                            width="590"
                                            style="min-width: 590px;
                                                    background-color: white;
                                                    font-size: 11px;
                                                    padding: 0px 8px 0px 8px;
                                                    border-collapse:separate;">

                                            <tr>
                                                <td valign="middle"
                                                    align="left">

                                                    <t t-out="object.env.company.name or ''">
                                                        YourCompany
                                                    </t>

                                                </td>
                                            </tr>

                                            <tr>
                                                <td valign="middle"
                                                    align="left"
                                                    style="opacity: 0.7;">

                                                    <t t-out="object.env.company.phone or ''">
                                                        +1 650-123-4567
                                                    </t>

                                                    <t t-if="object.env.company.email">
                                                        |
                                                        <a t-att-href="'mailto:%s' % object.env.company.email"
                                                        style="text-decoration:none;
                                                                color: #454748;"
                                                        t-out="object.env.company.email">
                                                            info@yourcompany.com
                                                        </a>
                                                    </t>

                                                    <t t-if="object.env.company.website">
                                                        |
                                                        <a t-att-href="'%s' % object.env.company.website"
                                                        style="text-decoration:none;
                                                                color: #454748;"
                                                        t-out="object.env.company.website">
                                                            http://www.example.com
                                                        </a>
                                                    </t>

                                                </td>
                                            </tr>

                                        </table>

                                    </td>
                                </tr>

                            </tbody>

                        </table>

                    </td>
                </tr>

            </table>
    </template>

    <!--##############################################-->


    <record id="mail_template_partner_revisar" model="mail.template">
        <field name="name">Trabajador - Estado Revisar</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="subject">Tu datos requieren ser actualizados</field>
        <field name="email_from">{{ object.env.company.name }} &lt;{{ object.env.company.email }}&gt;</field>
        <field name="email_to">{{ object.email }}</field>
        <field name="body_html" type="html">

            <t t-call="instance_sindicato.template_mail">
                <div style="text-align: left; margin: 30px 0;">
                    <p >
                        Hemos notado inconsitencias en tu documentacion, favor de verificar<br/>
                        - Foto tipo credencial (Saldra en tu gafete)<br/>
                        - Foto de tu INE<br/>
                        - Foto de tu tarjeton mas reciente                    
                    </p>
                    <p>
                        Por favor, verifica la información proporcionada.
                    </p>
                    <div style="text-align: center; margin: 30px 0;">
                        <a href="https://www.sntss-xxv.com/my/account"
                        style="
                            background-color:#875a7b;
                            padding:8px 16px 8px 16px;
                            text-decoration:none;
                            color:#fff;
                            border-radius:5px;font-size:13px
                        ">
                            Modificar datos
                        </a>
                    </div>                
                    <p>
                        Saludos.
                    </p>
                </div>
            </t>

        </field>
        <field name="auto_delete" eval="False"/>
    </record>

    <!--##############################################-->
    <!--##############################################-->
    <!--##############################################-->



    <record id="mail_template_eventos" model="mail.template">
        <field name="name">Eventos - Asistencia</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="subject">Constancia de Registro</field>
        <field name="email_from">{{ object.env.company.name }} &lt;{{ object.env.company.email }}&gt;</field>
        <field name="email_to">{{ object.email }}</field>
        <field name="body_html" type="html">

            <t t-call="instance_sindicato.template_mail">  
                <div style="text-align: left; margin: 30px 0;">
                    <p>
                        Se ha generado correctamente tu constancia
                        de registro para el evento          
                        <strong>
                            <t t-out="asistencia.evento_id.name"/>
                        </strong>.
                    </p>
                    <p>
                        Encontrarás la constancia adjunta a este correo
                        en formato PDF.
                    </p>
                    <p>
                        Saludos.
                    </p>
                </div>
            </t>


        </field>
        <field name="auto_delete" eval="False"/>
    </record>
</odoo>


