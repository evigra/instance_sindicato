<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================================= -->
    <!-- MIS HIJOS                                                -->
    <!-- ========================================================= -->

    <template id="portal_user_dropdown_children"
              inherit_id="portal.user_dropdown">

        <xpath expr="//div[@id='o_logout_divider']" position="before">
            <a href="/my/children"
               role="menuitem"
               class="dropdown-item ps-3"
               id="o_credential">
                <i class="fa fa-fw fa-id-card me-1 small text-primary text-primary-emphasis"/>
                Mi Familia
            </a>
        </xpath>
    </template>


    <template
        id="portal_my_children"
        name="Portal - Mis hijos"
    >

        <t t-call="portal.portal_layout">

            <t t-set="additional_title">
                Mis hijos
            </t>

            <div class="container">

                <div class="d-flex justify-content-between align-items-center mb-4">

                    <h3>
                        Mis hijos
                    </h3>

                    <a
                        href="/my/children/new"
                        class="btn btn-primary"
                    >
                        <i class="fa fa-plus me-1"/>
                        Agregar hijo
                    </a>

                </div>


                <!-- ================================================= -->
                <!-- SIN HIJOS                                         -->
                <!-- ================================================= -->

                <div
                    t-if="not children"
                    class="alert alert-info"
                >
                    No tienes hijos registrados.
                </div>


                <!-- ================================================= -->
                <!-- LISTA                                              -->
                <!-- ================================================= -->

                <div
                    t-if="children"
                    class="row"
                >

                    <t t-foreach="children" t-as="child">

                        <div class="col-12 col-md-6 col-lg-4 mb-4">

                            <div class="card h-100">

                  

                                <div class="card-body">

                                    <!-- ===================================================== -->
                                    <!-- FOTO DEL HIJO                                         -->
                                    <!-- ===================================================== -->

                                    <div class="text-center mb-3">

                                        <t t-if="child.image_1920">

                                            <img 
                                                t-att-src="'/my/child/image/%s' % child.id"
                                                class="img-fluid rounded-circle"
                                                style="width: 150px; height: 150px; object-fit: cover;"/>

                                        </t>

                                        <t t-else="">
                                            <div
                                                class="rounded-circle bg-light border d-inline-flex align-items-center justify-content-center"
                                                style="width: 140px; height: 140px;"
                                            >
                                                <i class="fa fa-user fa-4x text-muted"/>
                                            </div>
                                        </t>

                                    </div>


                                    <!-- ===================================================== -->
                                    <!-- NOMBRE                                                 -->
                                    <!-- ===================================================== -->

                                    <h5 class="card-title text-center">
                                        <t t-esc="child.name"/>
                                    </h5>



                                    <p
                                        t-if="child.child_birthdate"
                                        class="card-text"
                                    >
                                        <strong>
                                            Fecha de nacimiento:
                                        </strong>

                                        <t t-esc="child.child_birthdate"/>
                                    </p>

                                    <p
                                        t-if="child.child_curp"
                                        class="card-text"
                                    >
                                        <strong>
                                            CURP:
                                        </strong>

                                        <t t-esc="child.child_curp"/>
                                    </p>

                                    <p
                                        t-if="child.child_gender"
                                        class="card-text"
                                    >
                                        <strong>
                                            Sexo:
                                        </strong>

                                        <t
                                            t-if="child.child_gender == 'male'"
                                        >
                                            Masculino
                                        </t>

                                        <t
                                            t-if="child.child_gender == 'female'"
                                        >
                                            Femenino
                                        </t>
                                    </p>
                                    <a
                                        t-att-href="'/my/children/%s/credencial' % child.id"
                                        class="btn btn-outline-primary"
                                    >
                                        <i class="fa fa-id-card me-1"/>
                                        Credencial
                                    </a>

                                    <a
                                        t-att-href="'/my/children/%s/edit' % child.id"
                                        class="btn btn-outline-primary"
                                    >
                                        <i class="fa fa-pencil me-1"/>
                                        Editar
                                    </a>

                                </div>

                            </div>

                        </div>

                    </t>

                </div>

            </div>

        </t>

    </template>


    <!-- ========================================================= -->
    <!-- FORMULARIO HIJO                                           -->
    <!-- ========================================================= -->

    <template
        id="portal_my_child_form"
        name="Portal - Formulario hijo"
    >

        <t t-call="portal.portal_layout">

            <t t-set="additional_title">

                <t t-if="child">
                    Editar hijo
                </t>

                <t t-else="">
                    Agregar hijo
                </t>

            </t>


            <div class="container">

                <div class="row">

                    <div class="col-12 col-lg-8 offset-lg-2">

                        <div class="card">

                            <div class="card-body">

                                <h3 class="mb-4">

                                    <t t-if="child">
                                        Editar hijo
                                    </t>

                                    <t t-else="">
                                        Agregar hijo
                                    </t>

                                </h3>


                                <form
                                    method="post"
                                    enctype="multipart/form-data"
                                    t-att-action="
                                        '/my/children/%s/edit' % child.id
                                        if child
                                        else '/my/children/new'
                                    "
                                >

                                    <input
                                        type="hidden"
                                        name="csrf_token"
                                        t-att-value="request.csrf_token()"
                                    />


                                    <!-- NOMBRE -->

                                    <div class="mb-3">

                                        <label
                                            for="name"
                                            class="form-label"
                                        >
                                            Nombre completo
                                        </label>

                                        <input
                                            type="text"
                                            name="name"
                                            id="name"
                                            class="form-control"
                                            required="required"
                                            t-att-value="child.name if child else ''"
                                        />

                                    </div>

<!-- ========================================================= -->
<!-- FOTO DEL HIJO                                             -->
<!-- ========================================================= -->

<div class="mb-4">

    <label
        for="image_1920"
        class="form-label"
    >
        Fotografía
    </label>

    <!-- FOTO ACTUAL -->
    <div
        t-if="child and child.image_1920"
        class="mb-3"
    >


                                            <img 
                                                t-att-src="'/my/child/image/%s' % child.id"
                                                class="img-fluid rounded-circle"
                                                style="width: 150px; height: 150px; object-fit: cover;"/>



    </div>




    <!-- SELECCIONAR FOTO -->
    <input
        type="file"
        name="image_1920"
        id="image_1920"
        class="form-control"
        accept="image/*"
    />

    <div class="form-text">
        Selecciona una fotografía en formato JPG, PNG o similar.
    </div>

</div>

                                    <!-- FECHA NACIMIENTO -->

                                    <div class="mb-3">

                                        <label
                                            for="child_birthdate"
                                            class="form-label"
                                        >
                                            Fecha de nacimiento
                                        </label>

                                        <input
                                            type="date"
                                            name="child_birthdate"
                                            id="child_birthdate"
                                            class="form-control"
                                            t-att-value="
                                                child.child_birthdate
                                                if child and child.child_birthdate
                                                else ''
                                            "
                                        />

                                    </div>


                                    <!-- CURP -->

                                    <div class="mb-3">

                                        <label
                                            for="child_curp"
                                            class="form-label"
                                        >
                                            CURP
                                        </label>

                                        <input
                                            type="text"
                                            name="child_curp"
                                            id="child_curp"
                                            class="form-control"
                                            maxlength="18"
                                            t-att-value="
                                                child.child_curp
                                                if child
                                                else ''
                                            "
                                        />

                                    </div>


                                    <!-- SEXO -->

                                    <div class="mb-4">

                                        <label
                                            for="child_gender"
                                            class="form-label"
                                        >
                                            Sexo
                                        </label>

                                        <select
                                            name="child_gender"
                                            id="child_gender"
                                            class="form-select"
                                        >

                                            <option value="">
                                                Seleccionar
                                            </option>

                                            <option
                                                value="male"
                                                t-att-selected="
                                                    child and
                                                    child.child_gender == 'male'
                                                "
                                            >
                                                Masculino
                                            </option>

                                            <option
                                                value="female"
                                                t-att-selected="
                                                    child and
                                                    child.child_gender == 'female'
                                                "
                                            >
                                                Femenino
                                            </option>

                                        </select>

                                    </div>


                                    <!-- BOTONES -->

                                    <div class="d-flex gap-2">

                                        <a
                                            href="/my/children"
                                            class="btn btn-secondary"
                                        >
                                            Cancelar
                                        </a>

                                        <button
                                            type="submit"
                                            class="btn btn-primary"
                                        >
                                            <i class="fa fa-save me-1"/>
                                            Guardar
                                        </button>

                                    </div>

                                </form>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </t>

    </template>





