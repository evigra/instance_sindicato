<odoo>

<record id="view_partner_form_documents" model="ir.ui.view">
    <field name="name">res.partner.form.documents</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">

        <xpath expr="//notebook" position="inside">

            <page string="Documentos">

                    <!-- INE -->
                    <group string="INE">

                        <field
                            name="ine_file"
                            widget="image"
                            class="o_document_preview"
                            options="{'preview_image': 'ine_file'}"
                        />

                    </group>
                    <group string="Tarjetón">

                        <field
                            name="tarjeton_file"
                            widget="image"
                            class="o_document_preview"
                            options="{'preview_image': 'tarjeton_file'}"
                        />

                    </group>



            </page>

        </xpath>

    </field>
</record>

</odoo>
