<odoo>

    <!-- ========================================= -->
    <!-- TARJETA "MIS EVENTOS" EN EL PORTAL       -->
    <!-- ========================================= -->


    <template id="portal_user_dropdown_credential"
              inherit_id="portal.user_dropdown">

        <xpath expr="//div[@id='o_logout_divider']" position="before">

            <a href="/my/credencial"
               role="menuitem"
               class="dropdown-item ps-3"
               id="o_credential">
                <i class="fa fa-fw fa-id-card me-1 small text-primary text-primary-emphasis"/>
                Mi Credencial
            </a>
            <!--
            <a href="/my/familia"
               role="menuitem"
               class="dropdown-item ps-3"
               id="o_credential">
                <i class="fa fa-fw fa-id-card me-1 small text-primary text-primary-emphasis"/>
                Mi Familia
            </a>
            -->
        </xpath>

    </template>

    <template id="portal_my_home_eventos"    name="Mis Eventos"
              inherit_id="portal.portal_my_home"        priority="30">

        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">

            <div class="o_portal_category row g-2 mt-3" id="portal_common_eventos">
                <t t-call="portal.portal_docs_entry" t-if="False"/>
                <t t-call="portal.portal_docs_entry">
                    <t t-set="icon" t-value="'/portal/static/src/img/portal-connection.svg'"/>
                    <t t-set="title">Registros o Eventos</t>
                    <t t-set="text">Aqui encontraras </t>
                    <t t-set="url" t-value="'/my/eventos'"/>
                    <t t-set="config_card" t-value="True"/>
                </t>
            </div>

        </xpath>
    </template>

    <template id="portal_eventos"   name="Mis Eventos">
        <t t-call="portal.portal_layout">
            <t t-set="title">Mis Eventos o Registros</t>
            <div class="container">
                <!-- Breadcrumb 
                <div class="row">
                    <div class="col-12">
                        <t t-call="portal.portal_breadcrumbs"/>
                    </div>
                </div>
                -->
                <!-- Título -->
                <div class="row mb-4">
                    <div class="col-12">
                        <h2>   Mis Eventos o Registros </h2>
                    </div>
                </div>

                <!-- Lista de eventos -->
                <div class="row">
                    <t t-if="eventos">
                        <t t-foreach="eventos" t-as="evento">
                            <a class="col-md-6 col-lg-4 mb-4" t-att-href="'/my/eventos/%s' % evento.id">    
                                <div class="o_kanban_record d-flex shadow-sm cursor-pointer p-0 row">
                                    
                                    <div class="col-4 text-bg-primary p-2 text-center d-flex flex-column justify-content-center">
                                        <span style="font-size:50px" t-esc="evento.fecha.day"/>
                                        <span t-esc="format_date(evento.fecha, format='MMMM', locale='es_MX')"/><br/>
                                        <span t-esc="evento.fecha.year"/>

                                    </div>
                                    <div class="col pt-3 pb-2 px-3 justify-content-between">
                                        <h5 class="card-title">
                                            <t t-esc="evento.name"/>
                                        </h5>
                                        <p class="card-text">
                                            <strong>
                                                Vigencia:
                                            </strong><br/>
                                            <t t-if="evento.fecha_publicacion != evento.fecha_termino">
                                                del
                                                <span t-esc="format_date(evento.fecha_publicacion, format='dd', locale='es_MX')"/> de  
                                                <span t-esc="format_date(evento.fecha_publicacion, format='MMMM', locale='es_MX')"/> 
                                                al 
                                                <span t-esc="format_date(evento.fecha_termino, format='dd', locale='es_MX')"/> de
                                                <span t-esc="format_date(evento.fecha_termino, format='MMMM', locale='es_MX')"/>
                                            </t>
                                            <t t-else="">                                            
                                                <span t-esc="format_date(evento.fecha_termino, format='dd', locale='es_MX')"/> de
                                                <span t-esc="format_date(evento.fecha_termino, format='MMMM', locale='es_MX')"/>
                                            </t>
                                        </p>
                                        <!--
                                        <a t-att-href="'/my/eventos/%s' % evento.id" class="btn btn-primary">
                                            Ver evento
                                        </a>
                                        -->
                                    </div>
                                </div>
                            </a>
                        </t>
                    </t>
                    <!-- No hay eventos -->
                    <t t-else="">
                        <div class="col-12">
                            <div class="alert alert-info">
                                No tienes eventos disponibles.
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>


    <template id="portal_evento_detalle"
              name="Detalle del Evento">

        <t t-call="portal.portal_layout">

            <t t-if="evento">
                <t t-set="title">
                    <t t-esc="evento.name"/>
                </t>
                <div class="container">
                    <div class="card shadow-sm">
                            <t t-if="evento.publicacion_file">
                                <img t-att-src="'/web/image/eventos/%s/publicacion_file' % evento.id" width="100%"/>
                            </t>

                    </div>
                    <a target="_new" t-att-href="'/my/asistencias/%s' % evento.id"
                    class="btn btn-secondary">
                        Registrarme
                    </a>

                    <a href="/my/eventos"
                    class="btn btn-secondary">
                        Regresar a mis eventos
                    </a>
                </div>
            </t>
        </t>

    </template>


    <template id="portal_evento_asistencia"
              name="Detalle del Evento">

        <t t-call="portal.portal_layout">

            <t t-if="evento">

                <t t-set="title">
                    <t t-esc="evento.name"/>
                </t>
                <div class="container">
                    <!--
                    <t t-call="portal.portal_breadcrumbs"/>
                    -->
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <h2> 
                                <t t-esc="evento.name"/>
                            </h2>
                            <hr/>
                            <p>
                                Hola <t t-esc="partner.name"/><br/>
                                <br/>
                                
                                Te has registrado correctamente en este evento.<br/>
                                ¡Te esperamos!                            
                            
                            
                            </p>    

                            <a href="/my/eventos"
                            class="btn btn-secondary">
                                Regresar a mis eventos
                            </a>
                        </div>
                    </div>
                </div>
            </t>
        </t>

    </template>









<template id="report_asistencia_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 style="text-align: center;">
                            CONSTANCIA DE REGISTRO
                        </h2>
                        <span t-field="o.id"/>
                        <br/>
                        <p>
                            Hola  <b><span t-field="o.partner_id.name"/></b><br/>
                            con matrícula <b><span t-field="o.partner_id.matricula"/></b>
                        </p>
                        <p>
                            Generaste tu registro de forma exitosa<br/>en nuestra plataforma 
                            <a href="http://www.sntss-xxv.com">http://www.sntss-xxv.com</a><br/>
                            para participar en el evento <b><span t-field="o.evento_id.name"/></b>
                        </p>
                        <p>
                            Fecha de registro:
                            <strong>
                                <span t-field="o.fecha"/>
                            </strong>
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_asistencia" model="ir.actions.report">
        <field name="name">Constancia de Asistencia</field>
        <field name="model">asistencias</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">instance_sindicato.report_asistencia_document</field>
        <field name="report_file">instance_sindicato.report_asistencia_document</field>
        <field name="print_report_name">
            'Asistencia - %s' % (object.name)
        </field>
    </record>
</odoo>
