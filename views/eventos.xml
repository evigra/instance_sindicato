<odoo>
    <record id='eventos_view_form' model='ir.ui.view'>
        <field name="name">eventos.form</field>
        <field name="model">eventos</field>
        <field name="arch" type="xml">
            <form string="Evento">
                <header>
                    <field name="tipo" widget="statusbar" options="{'clickable': '1'}"/>
                    <field name="estado" widget="statusbar" options="{'clickable': '1'}"/>
                </header>

                <sheet>
                    <group col="1">
                        <group col="1">
                            <div class="oe_title" name="event_type_title">
                                <label for="name" string="Nombre del Evento"/>
                                <h1><field name="name" placeholder="p. ej. Reunion Sindical o Posada" /></h1>
                            </div>
                        </group>

                        <group col="2">
                            <group>
                    
                                <label for="fecha_publicacion" string="Vigencia"/>
                                <div class="o_row">
                                    <field name="fecha_publicacion" widget="daterange" nolabel="1" class="oe_inline" options="{'related_end_date': 'fecha_termino'}"/>
                                    <i class="fa fa-long-arrow-right mx-2" aria-label="Arrow icon" title="Arrow"/>
                                    <field name="fecha_termino" widget="daterange" nolabel="1" class="oe_inline" options="{'related_start_date': 'fecha_publicacion'}"/>
                                </div>
                                
                                
                            </group>    



                            <group>
                                <field name="fecha"/>
                                <field name="duracion"/>
                                
                            </group>

                        </group>
                    </group>
                        <notebook>
                            <page string="Asistencia" >
                                <field name="asistencia_ids">
                                    <list string="Models">
                                        <field name="partner_id"/>
                                        <field name="fecha"/>
                                        <field name="fecha_inicio"/>
                                        <field name="fecha_termino"/>
                                    </list>
                                    <form string="Asistencia">
                                        <sheet>
                                            <group>
                                                <field name="partner_id"/>
                                                <field name="fecha"/>
                                                <field name="fecha_inicio"/>
                                                <field name="fecha_termino"/>
                                            </group>
                                        </sheet>
                                    </form>
                                </field>
                            </page>

                        </notebook>
                    </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id='eventos_view_tree' model='ir.ui.view'>
        <field name="name">eventos.tree</field>
        <field name="model">eventos</field>
        <field name="arch" type="xml">
            <list string="Models">
                        <field name="name" />
                        <field name="tipo"/>
                        <field name="fecha"/>
                        <field name="duracion"/>
                        <field name="fecha_publicacion"/>
                        <field name="fecha_termino" />
                        <field name="estado" />
                        
                        <field name="total_asistencias" />
                        <field name="asistencias_iniciadas" />
                        <field name="asistencias_pendientes" />
                        
                        
            </list>
        </field>
    </record>
</odoo>
