<odoo>
    <record id='eventos_model_action' model='ir.actions.act_window'>
        <field name="name">Eventos</field>
        <field name="res_model">eventos</field>
        <field name="view_mode">list,form</field>
        
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Crea un nuevo evento
          </p>
          <p>
            Tu podras definir el tipo de evento (Reunion Sindical, Evento, Encuesta)
            
          </p>
        </field>
    </record>
    <record id='asistencias_model_action' model='ir.actions.act_window'>
        <field name="name">Asistencias</field>
